\subsection{Teorik Temel (Yeşiloğlu Tez Denklem 2.16)}
\begin{equation}
\mathcal{V}_k = \Phi_k \mathcal{V}_{k-1} + H_k \dot{q}_k
\end{equation}
\begin{equation}
\dot{\mathcal{V}}_k = \Phi_k \dot{\mathcal{V}}_{k-1} + H_k \ddot{q}_k + \mathcal{V}_k \times H_k \dot{q}_k
\end{equation}

\subsection{MATLAB Kod Çözümlemesi (Outboard\_Hesap)}
Blok içerisindeki ana döngü, her bir mafsalın hız ve ivme durumlarını Plücker vektörleri üzerinden günceller:

\begin{lstlisting}[style=matlabstyle]
function y = fcn(u)
H = cell(4,1); Phi = cell(4,1); idx = 1;
for k=1:4, H{k} = u(idx:idx+5); idx = idx + 6; end
for k=1:4, Phi{k} = reshape(u(idx:idx+35), 6, 6); idx = idx + 36; end
qdot = u(idx:idx+3); idx = idx + 4; qddot = u(idx:idx+3);
Vprev = zeros(6,1); Vdotprev = zeros(6,1); V = cell(4,1); Vd = cell(4,1);
for k=1:4
  Vk  = Phi{k}*Vprev + H{k}*qdot(k); 
  Vdk = Phi{k}*Vdotprev + H{k}*qddot(k) + crm(Vk)*(H{k}*qdot(k)); 
  V{k}=Vk; Vd{k}=Vdk; Vprev=Vk; Vdotprev=Vdk;
end
y = zeros(48,1); idx = 1;
for k=1:4, y(idx:idx+5) = V{k}; idx = idx + 6; end
for k=1:4, y(idx:idx+5) = Vd{k}; idx = idx + 6; end
end
function X=crm(V), w=V(1:3); v=V(4:6); X=[skew(w) zeros(3,3); skew(v) skew(w)]; end
function S=skew(a), S=[0 -a(3) a(2); a(3) 0 -a(1); -a(2) a(1) 0]; end
\end{lstlisting}\newpage
\section{3\_Geriye\_Dinamik\_Inboard Kuvvet Dengesi}
Newton-Euler algoritmasının çekirdeği olan kuvvet analizi bu modülde işletilir. Döngü, uçtan tabana doğru ilerlenerek toplam uzaysal kuvvetleri ($\mathcal{F}_k$) toplar.

\begin{figure}[h]
    \centering
    \centering\textbf{[BURAYA EKRAN GÖRÜNTÜSÜ 4: INBOARD (GERİYE DİNAMİK) BLOĞU GELECEK]}
    \caption{Şekil 4: Geriye Doğru İç Kuvvetlerin Hesaplanması.}
\end{figure}

\subsection{Teorik Kuvvet Dengesi (Yeşiloğlu Tez Denklem 2.20)}
\begin{equation}
\mathcal{F}_k = \mathcal{M}_k \dot{\mathcal{V}}_k + \mathcal{V}_k \times^* \mathcal{M}_k \mathcal{V}_k + \Phi_{k+1}^T \mathcal{F}_{k+1}
\end{equation}

\subsection{MATLAB Kod Çözümlemesi (Inboard\_Hesap)}
\begin{lstlisting}[style=matlabstyle]
function y = fcn(u)
Phi = cell(4,1); I_mat = cell(4,1); V = cell(4,1); Vd = cell(4,1); idx = 1;
for k=1:4, Phi{k} = reshape(u(idx:idx+35), 6, 6); idx = idx + 36; end
for k=1:4, I_mat{k} = reshape(u(idx:idx+35), 6, 6); idx = idx + 36; end
F=cell(4,1); Fchild=zeros(6,1);
for k=4:-1:1
  Fk = I_mat{k}*Vd{k} + crf(V{k})*(I_mat{k}*V{k}) + Fchild; 
  F{k}=Fk;
  if k>1, Fchild = Phi{k}' * Fk; end 
end
y = zeros(24,1); idx = 1;
for k=1:4, y(idx:idx+5) = F{k}; idx = idx + 6; end
end
function X=crf(V), X=-crm(V)'; end
\end{lstlisting}

